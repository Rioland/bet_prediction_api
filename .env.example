# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Database ---------------------------------------------------------------
# SQLite locally; Postgres in deployment. For Supabase use the connection
# string from Settings > Database (port 5432, direct), not the REST API URL.
PREDICTOR_DATABASE_URL=sqlite:///./local.db

# --- Auth -------------------------------------------------------------------
# Required in production. Without it, tokens are signed with a random secret
# that changes on every restart, invalidating all sessions.
JWT_SECRET=

# --- Models -----------------------------------------------------------------
MODEL_DIR=./models

# --- Data providers ---------------------------------------------------------
# Optional. Without a key the API falls back to ESPN, which needs no key but
# carries no betting odds.
FOOTBALL_API_KEY=

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
FIXTURE_REFRESH_ENABLED=1

# --- Admin seeding ----------------------------------------------------------
# Both must be set for an admin to be created; there is deliberately no
# default. Minimum 12 characters.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# --- OPay (payments) --------------------------------------------------------
# OPay merchant dashboard > API Keys & Webhooks. The secret key signs callbacks
# and status queries; never expose it to the browser.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
# Leave unset for staging. Setting this moves real money.
OPAY_PRODUCTION=
# Must be publicly reachable over HTTPS for callbacks to arrive.
PUBLIC_SITE_URL=
PUBLIC_API_URL=
